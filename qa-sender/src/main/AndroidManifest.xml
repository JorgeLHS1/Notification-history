<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- QA tool only: posts notifications. No network permission by design (AGENTS.md rule 6). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_action_chat"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QaSender">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Debug tool: intentionally exported and unprotected so adb can drive it. -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="br.com.lugedevelopment.notificationhistory.qasender.CMD" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
